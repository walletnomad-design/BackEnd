# =============================================================
# NomadWallet · Backend · Variables de entorno
# -------------------------------------------------------------
# Copia este archivo a `.env` y completá los valores reales.
# `.env` está en `.gitignore` y NUNCA se sube al repositorio:
# solo vive `.env.example` en git, con los nombres de variables
# y sin valores reales.
# =============================================================

# Conexión a PostgreSQL (Railway). Incluir ?sslmode=require.
DATABASE_URL=

# Secreto para firmar/verificar los JWT (auth, compartido con el equipo).
JWT_SECRET=

# API key de CurrencyFreaks (tasas de cambio reales; plan free = base USD).
CURRENCYFREAKS_API_KEY=

# API key de Google AI Studio para el chatbot Nomad AI (gemini-2.5-flash).
GEMINI_API_KEY=

# Puerto HTTP local. Default: 3000 si se omite.
PORT=3000

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=

EMAIL_FUNCTION_URL=https://front-end-beige-chi-12.vercel.app/api/send-transaction-email
EMAIL_FUNCTION_SECRET=